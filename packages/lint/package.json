{
  "name": "@lobehub/lint",
  "version": "2.1.7",
  "description": "Meta package that re-exports all LobeHub lint configurations",
  "homepage": "https://github.com/lobehub/lobe-lint",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-lint/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-lint.git",
    "directory": "packages/lint"
  },
  "license": "MIT",
  "author": "canisminor1990 <i@canisminor.cc>, Innei <i@innei.in>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./changelog": {
      "types": "./dist/changelog.d.mts",
      "import": "./dist/changelog.mjs",
      "require": "./dist/changelog.cjs"
    },
    "./release": {
      "types": "./dist/release.d.mts",
      "import": "./dist/release.mjs",
      "require": "./dist/release.cjs"
    },
    "./release-monorepo": {
      "types": "./dist/release-monorepo.d.mts",
      "import": "./dist/release-monorepo.mjs",
      "require": "./dist/release-monorepo.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/changelog.ts src/release.ts src/release-monorepo.ts",
    "dev": "tsdown src/index.ts src/changelog.ts src/release.ts src/release-monorepo.ts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lobehub/commitlint-config": "workspace:*",
    "@lobehub/eslint-config": "workspace:*",
    "@lobehub/prettier-config": "workspace:*",
    "@lobehub/remarklint-config": "workspace:*",
    "@lobehub/semantic-release-config": "workspace:*",
    "@lobehub/stylelint-config": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5 <7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
